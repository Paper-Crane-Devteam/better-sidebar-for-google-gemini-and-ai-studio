# Always resolve from the public registry, never a corporate mirror.
# package-lock.json records the full `resolved` URL of every package, and that
# lockfile ships inside the Firefox source zip that AMO reviewers use to
# reproduce the build. An internal mirror host would be unreachable for them
# (and would leak the hostname into a public artifact).
# Proxy settings are inherited from ~/.npmrc.
registry=https://registry.npmjs.org/
