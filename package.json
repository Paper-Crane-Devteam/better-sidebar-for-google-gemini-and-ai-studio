{
  "name": "better-sidebar-for-google-ai-studio",
  "type": "module",
  "version": "2.13.0",
  "private": true,
  "description": "Organize Gemini & AI Studio chats with folders, tags, full-text search, prompts, export, Drive sync, AI tools & more.",
  "author": "Paper Crane Devteam",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "devtap": "node scripts/devtap.mjs",
    "i18n": "node scripts/i18n.mjs",
    "postinstall": "patch-package && wxt prepare",
    "release": "bash scripts/release.sh",
    "publishGumroad": "gumroad products page publish eklogd ./landing.html --json --no-input --non-interactive"
  },
